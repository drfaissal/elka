<style>
  :root {
    --lavender-light: #F5F1FB;
    --lavender: #E3D9F5;
    --lavender-mid: #C9B6E8;
    --lavender-deep: #7A5FA8;
    --gold: #C9A660;
    --gold-light: #F0E4C8;
    --gold-dark: #A8843F;
    --text-dark: #362B4A;
    --text-soft: #6B5E80;
    --white: #FFFFFF;
    --shadow: 0 10px 30px rgba(122, 95, 168, 0.15);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    font-family: 'Tajawal', sans-serif;
    background: linear-gradient(180deg, var(--lavender-light) 0%, var(--white) 45%);
    color: var(--text-dark);
    line-height: 1.9;
    overflow-x: hidden;
  }

  .container { max-width: 960px; margin: 0 auto; padding: 0 22px; }

  /* ===== شريط التنقل ===== */
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: rgba(245, 241, 251, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--lavender);
  }
  .nav .container {
    display: flex; align-items: center; justify-content: space-between;
    height: 60px;
  }
  .logo {
    font-family: 'Aref Ruqaa', serif;
    font-size: 1.35rem; color: var(--lavender-deep);
    text-decoration: none; white-space: nowrap;
  }
  .logo span { color: var(--gold-dark); font-size: 0.95rem; }
  .nav-links { display: flex; gap: 20px; }
  .nav-links a {
    text-decoration: none; color: var(--text-soft);
    font-weight: 500; font-size: 0.95rem;
  }
  .nav-links a:hover { color: var(--lavender-deep); }

  /* ===== الترحيب ===== */
  .hero {
    text-align: center;
    padding: 70px 22px;
    background: radial-gradient(circle at 50% 0%, var(--lavender) 0%, var(--lavender-light) 60%, var(--white) 100%);
  }
  .hero .tag {
    display: inline-block;
    background: var(--gold-light); color: var(--gold-dark);
    padding: 6px 18px; border-radius: 999px;
    font-weight: 700; font-size: 0.9rem; margin-bottom: 22px;
  }
  .hero h1 {
    font-family: 'Aref Ruqaa', serif;
    font-size: clamp(2.2rem, 6.5vw, 3.6rem);
    color: var(--lavender-deep);
    line-height: 1.5; margin-bottom: 6px;
  }
  .hero .by {
    font-weight: 700; color: var(--gold-dark);
    letter-spacing: 1px; margin-bottom: 18px;
  }
  .hero p {
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    color: var(--text-soft);
    max-width: 600px; margin: 0 auto 32px; font-weight: 500;
  }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
    color: var(--white); text-decoration: none;
    padding: 14px 34px; border-radius: 999px;
    font-weight: 700; font-size: 1.05rem; font-family: inherit;
    box-shadow: 0 8px 22px rgba(168, 132, 63, 0.35);
    transition: transform .2s ease, box-shadow .2s ease;
    border: none; cursor: pointer;
  }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(168, 132, 63, 0.45); }
  .btn.ghost {
    background: transparent; color: var(--lavender-deep);
    border: 2px solid var(--lavender-mid); box-shadow: none; margin-inline-start: 10px;
  }
  .btn.ghost:hover { background: var(--lavender); }

  /* ===== الأقسام ===== */
  section { padding: 64px 0; }
  .section-title {
    font-family: 'Aref Ruqaa', serif;
    text-align: center; color: var(--lavender-deep);
    font-size: clamp(1.7rem, 4.5vw, 2.4rem); margin-bottom: 10px;
  }
  .section-sub {
    text-align: center; color: var(--text-soft);
    max-width: 560px; margin: 0 auto 38px;
  }

  /* ===== الخدمات ===== */
  .grid {
    display: grid; gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .card {
    background: var(--white);
    border: 1px solid var(--lavender);
    border-radius: 22px; padding: 28px 24px;
    box-shadow: var(--shadow);
    transition: transform .25s ease;
  }
  .card:hover { transform: translateY(-4px); }
  .card .icon {
    width: 56px; height: 56px; border-radius: 16px;
    background: linear-gradient(135deg, var(--lavender) 0%, var(--gold-light) 100%);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.7rem; margin-bottom: 16px;
  }
  .card h3 { color: var(--lavender-deep); font-size: 1.2rem; margin-bottom: 6px; }
  .card p { color: var(--text-soft); font-size: 0.98rem; line-height: 1.8; }

  .online-note {
    margin: 34px auto 0; max-width: 640px; text-align: center;
    background: var(--lavender-light); border: 1px dashed var(--lavender-mid);
    border-radius: 18px; padding: 16px 20px;
    color: var(--text-soft); font-weight: 500;
  }

  /* ===== تواصل معنا ===== */
  .contact { background: linear-gradient(180deg, var(--white) 0%, var(--lavender-light) 100%); }
  .contact-box {
    background: var(--white);
    border: 1px solid var(--lavender);
    border-radius: 28px; padding: 40px 26px;
    text-align: center; box-shadow: var(--shadow);
    max-width: 640px; margin: 0 auto;
  }
  .contact-box p { color: var(--text-soft); margin-bottom: 26px; }
  .contact-box .contact-note { margin: 20px 0 0; font-size: 0.9rem; }

  /* ===== التذييل ===== */
  footer {
    text-align: center; padding: 28px 22px 100px;
    color: var(--text-soft); font-size: 0.9rem;
  }
  footer strong { color: var(--gold-dark); }

  /* ===== زر واتساب عائم (يسار الشاشة حتى لا يتعارض مع فقاعة الشات) ===== */
  .wa-float {
    position: fixed; left: 18px; bottom: 18px; z-index: 40;
    width: 56px; height: 56px; border-radius: 50%;
    background: #25D366;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 20px rgba(0,0,0,.2);
    text-decoration: none;
  }
  .wa-float svg { width: 30px; height: 30px; fill: #fff; }

  /* ===== ألوان فقاعة الشات ===== */
  :root {
    --chat--color-primary: #7A5FA8;
    --chat--color-primary-shade-50: #6b5094;
    --chat--color-primary-shade-100: #5c4380;
    --chat--color-secondary: #C9A660;
    --chat--color-secondary-shade-50: #A8843F;
    --chat--toggle--background: #7A5FA8;
    --chat--toggle--hover--background: #5c4380;
    --chat--toggle--active--background: #5c4380;
    --chat--header--background: #7A5FA8;
    --chat--font-family: 'Tajawal', sans-serif;
  }
  .chat-window-wrapper, .n8n-chat { direction: rtl; font-family: 'Tajawal', sans-serif; }

  @media (max-width: 520px) {
